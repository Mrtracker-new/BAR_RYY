# ============================================
# BAR Web Frontend - Environment Configuration
# ============================================

# Backend API URL (without trailing slash)
# In development: leave empty to use Vite proxy (/upload, /seal, /health -> http://localhost:8000)
# In production (e.g. Vercel): set to your deployed backend URL:
# VITE_BACKEND_URL=https://bar-web-backend-139d.onrender.com
VITE_BACKEND_URL=

# Public site URL (for OpenGraph previews and share links)
# VITE_SITE_URL=https://bar-rnr.vercel.app
VITE_SITE_URL=
